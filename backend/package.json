{
  "name": "hotel-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL (native SQL) backend for the Hotel Management app",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/initDb.js --seed",
    "db:reset": "node scripts/resetHotels.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.5.0",
    "pg": "^8.13.0"
  }
}
